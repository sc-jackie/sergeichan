67":3,"1768":3,"1769":3,"1770":3,"1771":3,"1772":3,"1773":3,"1774":3,"1775":3,"1776":3,"1777":3,"1778":3,"1779":3,"1780":3,"1781":3,"1782":3,"1783":3,"1784":3,"1785":3,"1786":3,"1787":3,"1788":3,"1789":3,"1790":3,"1791":3,"1792":3,"1793":3,"1794":3,"1795":3,"1796":3,"1797":3,"1798":3,"1799":3,"1800":3,"1801":3,"1802":3,"1803":3,"1804":3,"1805":3,"1806":3,"1807":3,"1808":3,"1809":3,"1810":3,"1811":3,"1812":3,"1813":3,"1814":3,"1815":3,"1816":3,"1817":3,"1818":3,"1819":3,"1820":3,"1821":3,"1822":3,"1823":3,"1824":3,"1825":3,"1826":3,"1827":3,"1828":3,"1829":3,"1830":3,"1831":3,"1832":3,"1833":3,"1834":3,"1835":3,"1836":3,"1837":3,"1838":3,"1839":3}}},"docs":{"docs":{"1":{"id":"/docs/add-a-project","page_id":"/docs/add-a-project","type":"page","content":"new-project","breadcrumbs":["Docs","What do I do?"],"tags":[],"url":"/docs/add-a-project"},"2":{"id":"/docs/add-a-project-0","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project","content":"One-shot onboarding for a new project — code repo or non-code — into Jackie OS."},"3":{"id":"/docs/add-a-project-1","page_id":"/docs/add-a-project","type":"heading","tags":[],"url":"/docs/add-a-project#step-0--classify","content":"Step 0 — classify"},"4":{"id":"/docs/add-a-project-2","page_id":"/docs/add-a-project","type":"heading","tags":[],"url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"Path A — code project (own git repo)"},"5":{"id":"/docs/add-a-project-3","page_id":"/docs/add-a-project","type":"heading","tags":[],"url":"/docs/add-a-project#path-b--non-code-project-lives-inside-jackie-os","content":"Path B — non-code project (lives inside jackie-os)"},"6":{"id":"/docs/add-a-project-4","page_id":"/docs/add-a-project","type":"heading","tags":[],"url":"/docs/add-a-project#one-time-prerequisite-sergei-once-ever--not-per-project","content":"One-time prerequisite (Sergei, once ever — not per project)"},"7":{"id":"/docs/add-a-project-5","page_id":"/docs/add-a-project","type":"heading","tags":[],"url":"/docs/add-a-project#verification","content":"Verification"},"8":{"id":"/docs/add-a-project-6","page_id":"/docs/add-a-project","type":"heading","tags":[],"url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"Workflows that pick up automatically (after onboarding)"},"9":{"id":"/docs/add-a-project-7","page_id":"/docs/add-a-project","type":"heading","tags":[],"url":"/docs/add-a-project#rules","content":"Rules"},"10":{"id":"/docs/add-a-project-8","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project","content":"**Purpose:** one-shot onboarding for a **new project — code repo OR non-code** — into Jackie OS, so everything (registry, vault note, indexes, learnings, sync coverage) is wired *before* real work starts. The agent does all the wiring; for code repos there is **zero** manual setup if the read PAT is scoped to all your repos (see § One-time prerequisite)."},"11":{"id":"/docs/add-a-project-9","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project","content":"**Trigger:** \"new project\", \"new code project\", \"new non-code project\", \"register project\", \"I created a repo\", \"set up project X\" — or the agent detects an unregistered project Sergei is starting."},"12":{"id":"/docs/add-a-project-10","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project","content":"**Role:** COO + CTO setup."},"13":{"id":"/docs/add-a-project-11","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project","content":"**Output:** registry row; `Vault/{Title}.md` note; `Projects.md` / `Home.md` index links; (code) repo bridge + learnings catalog + poller registration; (non-code) `Projects/{Name}/` folder; one commit."},"14":{"id":"/docs/add-a-project-12","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#step-0--classify","content":"Ask (or infer): **project name / title**, **type** — `code` (its own git repo) or `non-code` (lives inside jackie-os) — &#x2A;*active?**, and for code: **GitHub remote** (`owner/repo`), **local path**, **default branch** (`main`), &#x2A;*owned or shared?**."},"15":{"id":"/docs/add-a-project-13","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#step-0--classify","content":"Then run the matching path. Both end with a single `git commit` in jackie-os."},"16":{"id":"/docs/add-a-project-14","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"> **Ownership gate:** if the remote owner isn't Sergei's account (e.g. `AleannLab/…`) or he says it's shared, mark the registry row 🤝 **read-only**, and **skip steps 4–6** (repo bridge, design system, code-repo commit) — Jackie-OS reads a shared repo into the vault but never writes to it and never polls it with the PAT."},"17":{"id":"/docs/add-a-project-15","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Registry** — add a `git` row to `System/project-registry.md`: paths, branch, GitHub remote, mirror if any, **Roadmap index** (`plans/roadmap-index.md` — required for owned repos; `—` for shared 🤝)."},"18":{"id":"/docs/add-a-project-16","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Vault note + indexes** — `Vault/{Title}.md` (frontmatter `[[Projects]]`, stub, empty `## Status`); add wikilink to `Vault/Projects.md`; if Active, add to `Vault/Home.md` Active list."},"19":{"id":"/docs/add-a-project-17","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Learnings** — `Vault/Agent-Learnings/{Title} learnings.md` from the Newfin learnings template; add a row to `Vault/Agent-Learnings/Index.md`."},"20":{"id":"/docs/add-a-project-18","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Repo bridge** (in the **code repo** — owned only): copy `System/templates/JACKIE-OS-bridge.md` → `docs/JACKIE-OS.md` (fill KEY, vault note, branch); scaffold `docs/solutions/README.md` if missing; add the **Vault sync** paragraph to the repo's `CLAUDE.md`/`AGENTS.md` (point to `docs/JACKIE-OS.md`)."},"21":{"id":"/docs/add-a-project-19","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Plans scaffold** (owned code repos only — skip 🤝 shared):"},"22":{"id":"/docs/add-a-project-20","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"Create `plans/` from `System/templates/plans/`: `README.md`, `roadmap-index.md`, `future-improvements.md`, `archive/README.md`."},"23":{"id":"/docs/add-a-project-21","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"Replace placeholders: `{PROJECT}` = display name, `{DATE}` = today `YYYY-MM-DD`, `{INITIAL_SHA}` = `git rev-parse --short HEAD` (or `0000000` before first commit)."},"24":{"id":"/docs/add-a-project-22","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"Append planning section to `CLAUDE.md` (create `## Planning` if missing). Mirror one line in `AGENTS.md` if present."},"25":{"id":"/docs/add-a-project-23","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"In vault note `## Status` stub, link `plans/roadmap-index.md` as the forward-work surface."},"26":{"id":"/docs/add-a-project-24","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Do not** copy Newfin/Rodyna-specific archives — empty `plans/archive/` except README."},"27":{"id":"/docs/add-a-project-25","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Design system** (owned code repos — skip API-only / CLI-only / shared 🤝):"},"28":{"id":"/docs/add-a-project-26","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**When:** Step 0 expects a user-facing UI, *or* the repo already has a frontend package (`web/`, `miniapp/`, `frontend/`, `apps/*/web`, or a subdir with `react`/`vue`/`svelte` in `package.json`). If Sergei says \"no UI\", skip."},"29":{"id":"/docs/add-a-project-27","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Doc path** (first match):"},"30":{"id":"/docs/add-a-project-28","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"`miniapp/` → `miniapp/docs/design-memory.md`"},"31":{"id":"/docs/add-a-project-29","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"`web/` at repo root → `docs/design-system.md` (token source: `web/src/styles/globals.css` or project's token file)"},"32":{"id":"/docs/add-a-project-30","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"other UI package `{pkg}/` → `{pkg}/docs/design-memory.md`"},"33":{"id":"/docs/add-a-project-31","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"UI planned but not scaffolded yet → `docs/design-system.md` at repo root (`{UI_PACKAGE}` = *TBD*, `{TOKEN_SOURCE}` = *TBD*)"},"34":{"id":"/docs/add-a-project-32","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"Copy design system template; replace `{PROJECT}`, `{UI_PACKAGE}`, `{TOKEN_SOURCE}`. Template includes YAML frontmatter (DESIGN.md format) + prose; fill anchor token values from the token CSS file. Do not overwrite an existing design doc — merge or skip if one is already canonical (e.g. Newfin `docs/design-system.md`, Rodyna `miniapp/docs/design-memory.md`)."},"35":{"id":"/docs/add-a-project-33","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"Add &#x2A;*`design:lint`** to the repo root `package.json` (or UI workspace `package.json` if no root scripts): `\"design:lint\": \"npx -p @google/design.md@0.3.0 designmd lint &#60;DESIGN_DOC_REL>\"` — path matches the doc from the bullet above."},"36":{"id":"/docs/add-a-project-34","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"Append the **UI** section from design section template to `AGENTS.md` and/or `CLAUDE.md` (replace `{UI_PACKAGE}`, `{DESIGN_DOC_REL}`). Skip if an equivalent section already points at the design doc."},"37":{"id":"/docs/add-a-project-35","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Page-load benchmark (FF 003):** copy benchmark page-load template into the repo (path per layout — e.g. `docs/performance.md` or `{UI_PACKAGE}/docs/performance.md`). Scaffold benchmark script from Newfin (`server/src/scripts/benchmark-page-load.ts`) or Rodyna (`miniapp/scripts/benchmark-page-load.ts`) pattern. Add `npm run benchmark:pages` + Definition of done line: *new screen → add to benchmark; all routes \\<50ms p50 warm*."},"38":{"id":"/docs/add-a-project-36","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"Optional later (not required at onboarding): `npm run setup:ui` + mock API + deep links — see Rodyna `miniapp/README.md` § Plain-browser design work."},"39":{"id":"/docs/add-a-project-37","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Commit in the code repo** — bridge + solutions + &#x2A;*plans/** + design doc + AGENTS/CLAUDE blurbs in one PR or push."},"40":{"id":"/docs/add-a-project-38","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Poller — nothing to do.** The merge-poll is **registry-driven** (`.github/scripts/merge_poll.py` reads `project-registry.md`), so adding the row in **A1** already puts the repo under the intraday poll (owned `sc-jackie/*`, Active, not shared)."},"41":{"id":"/docs/add-a-project-39","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Project-sync** — run project-sync; prepend the vault `## Status` stub; refresh `hot.md` if Active."},"42":{"id":"/docs/add-a-project-40","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-a--code-project-own-git-repo","content":"**Linear + agents** (optional, owned repos) — to put the repo on the Linear board with agent-team delegation (Fablio / Cursorio / Codexio / Cyrusio), run linear-project-rollout next. The 3 label groups (`Pipeline`/`Stage`/`Type`) are workspace-shared, so there's nothing to create — just a project + IDs swap."},"43":{"id":"/docs/add-a-project-41","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-b--non-code-project-lives-inside-jackie-os","content":"No GitHub repo, no bridge, no Action, no secret — the work is *in* the vault, so the commit **is** the sync."},"44":{"id":"/docs/add-a-project-42","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-b--non-code-project-lives-inside-jackie-os","content":"**Folder** — create `Projects/{Name}/` for working files; add `Projects/{Name}/STATUS.md` only if you want a `status-file` mirror."},"45":{"id":"/docs/add-a-project-43","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-b--non-code-project-lives-inside-jackie-os","content":"**Plans scaffold** — create `Projects/{Name}/plans/` from project plans templates: `README.md`, `roadmap-index.md`, `future-improvements.md`, `archive/README.md`. Replace `{PROJECT}`, `{VAULT_NOTE}`, `{DATE}`. Registry **Roadmap index** → `Projects/{Name}/plans/roadmap-index.md`."},"46":{"id":"/docs/add-a-project-44","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-b--non-code-project-lives-inside-jackie-os","content":"**Registry** — add a `vault` row (or `status-file` row if you made a STATUS.md) to `System/project-registry.md` with Roadmap index path from step 2."},"47":{"id":"/docs/add-a-project-45","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-b--non-code-project-lives-inside-jackie-os","content":"**Vault note + indexes** — `Vault/{Title}.md` (frontmatter, stub, empty `## Status`); wikilink in `Vault/Projects.md`; Active list in `Home.md` if active. Link `Projects/{Name}/plans/roadmap-index.md` in the stub."},"48":{"id":"/docs/add-a-project-46","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#path-b--non-code-project-lives-inside-jackie-os","content":"**Commit** — `git commit` jackie-os. Done — morning-brief + wrap-up track it from here."},"49":{"id":"/docs/add-a-project-47","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#one-time-prerequisite-sergei-once-ever--not-per-project","content":"For code repos to get **intraday** merge-poll coverage, jackie-os needs one secret:"},"50":{"id":"/docs/add-a-project-48","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#one-time-prerequisite-sergei-once-ever--not-per-project","content":"Create **one** fine-grained PAT → **Contents: Read**, scoped to **All repositories** under `sc-jackie` (so every future repo is auto-covered — no per-project secret work)."},"51":{"id":"/docs/add-a-project-49","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#one-time-prerequisite-sergei-once-ever--not-per-project","content":"Add it to jackie-os → Settings → Secrets and variables → Actions → &#x2A;*`JACKIE_OS_READ_PAT`**."},"52":{"id":"/docs/add-a-project-50","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#one-time-prerequisite-sergei-once-ever--not-per-project","content":"Skip this and code repos still sync **daily** via the 07:30 morning-brief — you just lose the intraday entry. Non-code projects need nothing."},"53":{"id":"/docs/add-a-project-51","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#verification","content":"`project-sync` shows the new row without errors (path exists, or flagged skip)."},"54":{"id":"/docs/add-a-project-52","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#verification","content":"Vault note + index links exist; (code) learnings catalog + `Index.md` row present."},"55":{"id":"/docs/add-a-project-53","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#verification","content":"**Code, owned:** `docs/JACKIE-OS.md` + `docs/solutions/README.md&#x60; + &#x2A;*`plans/`** (roadmap-index, future-improvements, README, archive/) committed in the repo; `CLAUDE.md` **Planning** section; repo in merge poll via registry. &#x2A;*UI repos:** design doc + `AGENTS.md`/`CLAUDE.md` UI section + **page-load benchmark** (`npm run benchmark:pages`, \\<50ms p50 DoD) — or documented skip reason. &#x2A;*Shared (🤝):** confirm NOTHING was written/pushed to the repo, Roadmap index = `—`, and it's NOT in `merge_poll.py`."},"56":{"id":"/docs/add-a-project-54","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#verification","content":"**Non-code:** `Projects/{Name}/&#x60; + &#x2A;*`Projects/{Name}/plans/`** + vault note committed; no repo/bridge/Action created."},"57":{"id":"/docs/add-a-project-55","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"Workflow"},"58":{"id":"/docs/add-a-project-56","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"How it finds the project"},"59":{"id":"/docs/add-a-project-57","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"**project-sync**"},"60":{"id":"/docs/add-a-project-58","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"`System/project-registry.md`"},"61":{"id":"/docs/add-a-project-59","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"**morning-brief (07:30)**"},"62":{"id":"/docs/add-a-project-60","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"Active registry rows → rich vault Status daily (authoritative sync)"},"63":{"id":"/docs/add-a-project-61","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"**merge-poll (\\~3h)**"},"64":{"id":"/docs/add-a-project-62","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"`.github/scripts/merge_poll.py` REPOS — code repos only, thin intraday entry"},"65":{"id":"/docs/add-a-project-63","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"**wrap-up**"},"66":{"id":"/docs/add-a-project-64","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"project-sync all rows; § Catalog cleanup on `plans/` when code ships"},"67":{"id":"/docs/add-a-project-65","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"**hot.md**"},"68":{"id":"/docs/add-a-project-66","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"Active project one-liners from vault Status"},"69":{"id":"/docs/add-a-project-67","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"**weekly-review**"},"70":{"id":"/docs/add-a-project-68","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"Vault notes + week dailies"},"71":{"id":"/docs/add-a-project-69","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"**jos-compound**"},"72":{"id":"/docs/add-a-project-70","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"Run **in-session** after a non-trivial fix (not automated) → repo `docs/solutions/` + agent-learnings-index row"},"73":{"id":"/docs/add-a-project-71","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"**Planning loop**"},"74":{"id":"/docs/add-a-project-72","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"`plans/roadmap-index.md` → dated plan → ship → archive + catalog cleanup (wrap-up)"},"75":{"id":"/docs/add-a-project-73","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#workflows-that-pick-up-automatically-after-onboarding","content":"**Do not auto-wire:** Cursor automations (none exist), Peaches-style Cowork one-offs, Hermes VPS."},"76":{"id":"/docs/add-a-project-74","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#rules","content":"Push the code repo before expecting project-sync to see commits."},"77":{"id":"/docs/add-a-project-75","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#rules","content":"Nested repo inside Jackie-OS (Rodyna pattern): ensure the clone is in jackie-os `.gitignore`; registry path points at the clone."},"78":{"id":"/docs/add-a-project-76","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#rules","content":"Never duplicate full `docs/solutions/` bodies into the vault — index rows only."},"79":{"id":"/docs/add-a-project-77","page_id":"/docs/add-a-project","tags":[],"type":"text","url":"/docs/add-a-project#rules","content":"**Shared / external / contribute-only repos (🤝, e.g. `AleannLab/draw`):** registry + vault note + learnings catalog are OK (Jackie-OS side only). **Never** write a bridge/`docs/solutions/`/CLAUDE.md into the repo, never push/PR to it, never add it to `merge_poll.py`. Sync is read-only via morning-brief."},"80":{"id":"/docs/architecture","page_id":"/docs/architecture","type":"page","content":"Ecosystem Architecture","breadcrumbs":["Docs","What is this system?"],"tags":[],"url":"/docs/architecture"},"81":{"id":"/docs/architecture-0","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture","content":"One-screen map of three systems, shared rails, and how Hermes ties them together."},"82":{"id":"/docs/architecture-1","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"1\\. Jackie-OS — the AI operating system"},"83":{"id":"/docs/architecture-2","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#roles","content":"Roles"},"84":{"id":"/docs/architecture-3","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#automation-reality-2026-07-10","content":"Automation reality (2026-07-10)"},"85":{"id":"/docs/architecture-4","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"1b. LLM Gateway — subscription OAuth, no API billing (as of 2026-07-10)"},"86":{"id":"/docs/architecture-5","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"2\\. Newfin — net-worth + financial advisor (`~/dev/newfin`)"},"87":{"id":"/docs/architecture-6","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"3\\. Rodyna — family recipes (`~/dev/rodyna`)"},"88":{"id":"/docs/architecture-7","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#4-draw--tennis-community-platform-devdraw","content":"4\\. Draw — tennis community platform (`~/dev/draw`)"},"89":{"id":"/docs/architecture-8","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#4b-b-unit--habit--quest-app-devbunit--projectsb-unit","content":"4b. B-Unit — habit + quest app (`~/dev/bunit` + `Projects/B-Unit/`)"},"90":{"id":"/docs/architecture-9","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#5-shared-rails--same-infra-different-products","content":"5\\. Shared rails — same infra, different products"},"91":{"id":"/docs/architecture-10","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#pointers","content":"Pointers"},"92":{"id":"/docs/architecture-11","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture","content":"**One operator, three systems, one spine.** Jackie-OS is the always-on AI operating layer; Newfin and Rodyna are independent product repos that ride the same shared rails. The spine is **Hermes** (the VPS gateway): the single LLM gateway, the cron host, and the SSH bridge into Newfin."},"93":{"id":"/docs/architecture-12","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture","content":"> **Quick rule for agents:** code lives in `~/dev/{newfin,rodyna,draw}` (CTO territory). *Knowledge about* the code lives in the vault (`Vault/Newfin.md`, `Vault/Rodyna.md`). Technical fix write-ups live in each repo's `docs/solutions/`. Don't confuse the two."},"94":{"id":"/docs/architecture-13","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture","content":"Solid = data/control flow · dotted `knowledge about` = vault notes, not code · Newfin & Rodyna would run without Jackie-OS; Hermes is what makes it one OS."},"95":{"id":"/docs/architecture-14","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"Sergei's always-on OS. The **vault is memory**, **skills are the contract**, **scripts are dumb runners**, **Hermes is the 24/7 instance** on a VPS. Tool-agnostic: any agent that opens `~/Jackie-OS` and reads `CLAUDE.md` *becomes* an instance. Hosts four code repos (Newfin, Rodyna, Draw, B-Unit) and multiple products/projects (B-Unit, Peaches Beauty, Nastusha), all synced to the vault via `project-sync`."},"96":{"id":"/docs/architecture-15","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"**Stack:** Obsidian (markdown) · bash/Python runners · Claude Agent SDK · VPS cron (Europe/Warsaw) · git + symlink farm · Telegram Bot API."},"97":{"id":"/docs/architecture-16","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"**Layers:**"},"98":{"id":"/docs/architecture-17","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"**Vault** (`Vault/`) — journals, project notes, briefs, coaching corpus, ops board, `Agent-Learnings/` index. Source of truth."},"99":{"id":"/docs/architecture-18","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"**Skills** (`System/skills/`) — markdown agent specs (morning-brief, project-sync, research, wrap-up, coaching, …)."},"100":{"id":"/docs/architecture-19","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"**Scripts** (`System/{coo,capture,ops,periodic,work,lib}/`) — edited in repo, run on VPS via a **symlink farm** (`~/.hermes/scripts/&#60;name>` → repo). Repo is the source of truth; never edit the VPS copy."},"101":{"id":"/docs/architecture-20","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"**Script groups by function:**"},"102":{"id":"/docs/architecture-21","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"`coo/` — COO ops (brief delivery, Telegram integration, vault index updates)"},"103":{"id":"/docs/architecture-22","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"`capture/` — journal capture, Telegram sweep, trade digest, meeting capture"},"104":{"id":"/docs/architecture-23","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"`ops/` — VPS service health, Hermes ops proxy, code exec gate, notify endpoint"},"105":{"id":"/docs/architecture-24","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"`periodic/` — intel weekly, codebase index (`cbm`), janitor maintenance"},"106":{"id":"/docs/architecture-25","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"`work/` — ad-hoc agent work (code ask, wrap-up ops)"},"107":{"id":"/docs/architecture-26","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"`lib/` — shared utilities (env loader, logging helpers)"},"108":{"id":"/docs/architecture-27","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"**Secrets** (`.secrets/*.env`) — gitignored, mode 0600."},"109":{"id":"/docs/architecture-28","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1-jackie-os--the-ai-operating-system","content":"**Hermes VPS** (`hermes@your-vps-host`) — one Agent SDK instance as the `hermes` user; **one LLM gateway** for all calls (failover chain). Dashboard `:9119`, Headroom proxy `:8787`."},"110":{"id":"/docs/architecture-29","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"Claude takes a functional role per task. Each role defines what to read and produce:"},"111":{"id":"/docs/architecture-30","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"Role"},"112":{"id":"/docs/architecture-31","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"What it does"},"113":{"id":"/docs/architecture-32","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"**COO** (default)"},"114":{"id":"/docs/architecture-33","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"Personal assistant / PM. Daily briefs, task lists, project status, calendar, ops board."},"115":{"id":"/docs/architecture-34","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"**CPO**"},"116":{"id":"/docs/architecture-35","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"Planning, feature scoping, roadmap work on project notes."},"117":{"id":"/docs/architecture-36","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"**CMO**"},"118":{"id":"/docs/architecture-37","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"Marketing: SEO/content for Peaches Beauty, community virality."},"119":{"id":"/docs/architecture-38","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"**CRO**"},"120":{"id":"/docs/architecture-39","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"Community research (`research &#60;topic>`, last30days engine, optional `and file` → Clippings)."},"121":{"id":"/docs/architecture-40","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"**CTO**"},"122":{"id":"/docs/architecture-41","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"Code in `~/dev/{newfin,rodyna,draw}` via Claude Code / Cursor. Same agent, different hat."},"123":{"id":"/docs/architecture-42","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"**CFO**"},"124":{"id":"/docs/architecture-43","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"Financial analysis; Newfin/Persik handle live data, vault holds decisions only."},"125":{"id":"/docs/architecture-44","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"**Coach**"},"126":{"id":"/docs/architecture-45","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"Recovery, identity, periodic reviews (week/month/year)."},"127":{"id":"/docs/architecture-46","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#roles","content":"**Agent portability:** any editor that opens `~/Jackie-OS` and reads `CLAUDE.md` auto-becomes a Jackie-OS agent. Hermes VPS is simply the always-on 24/7 instance of that same agent."},"128":{"id":"/docs/architecture-47","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"Three automation layers (a job must never live in multiple, or it double-runs). The VPS owns everything; Cowork on the Mac is **effectively retired** — one leftover schedule (weekly-review) is all that remains:"},"129":{"id":"/docs/architecture-48","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"Layer"},"130":{"id":"/docs/architecture-49","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"Jobs"},"131":{"id":"/docs/architecture-50","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"**Hermes Agent cron** (`hermes cron list`)"},"132":{"id":"/docs/architecture-51","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"`morning-brief` (07:30) · `journal-capture` (hourly) · `telegram-sweep` (07:00) · `trade-digest` (07:10) — **4 jobs**"},"133":{"id":"/docs/architecture-52","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"**OS crontab** (`crontab -l`, `hermes` user)"},"134":{"id":"/docs/architecture-53","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"autodeploy (`*/2`) · merge-poll (\\~2h) · healthcheck (08:00) · degraded-brief (08:35) · intel-weekly (Sun) · cbm-index (Sun) · janitor (quarterly)"},"135":{"id":"/docs/architecture-54","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"**Mac weekly-review** (last Cowork schedule)"},"136":{"id":"/docs/architecture-55","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"`jackie-os-weekly-review` (Sun 18:00) — compound + weekly brief generation"},"137":{"id":"/docs/architecture-56","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"> **Research.** Quick research is on-demand (the `research &#60;topic>` skill, Persik\n> `/research` counsel-lane turn, or `hermes-ops flush research`); the 06:45\n> `research-bridge` agent-cron was **removed 2026-06-30** and watchlist auto-research\n> no longer runs unattended. **Deep research** (Persik `/research deep …`) IS a\n> standing job: `hermes-research-worker.sh` (`*/5` OS crontab, flock) polls newfin's\n> `research_jobs` queue for `mode=deep`, runs an XPL-grade OAuth-CLI pass, and PATCHes\n> a self-contained HTML report back (DM + Telegram document + Intel ▸ Research). Prompt:\n> `System/work/deep-research-prompt.md`."},"138":{"id":"/docs/architecture-57","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#automation-reality-2026-07-10","content":"**Morning brief flow (07:30):** `git pull` → project-sync (thin merge-poll on VPS) → LLM brief → calendar → Telegram + HTML → single commit + push. Backstop: degraded-brief at 08:35 if no deliverable brief exists."},"139":{"id":"/docs/architecture-58","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"**Hermes CLI** on VPS is the gateway for Jackie-OS AI calls. **Canonical chain table lives in Concepts § Hermes VPS** — summary:"},"140":{"id":"/docs/architecture-59","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"Chain"},"141":{"id":"/docs/architecture-60","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"Models"},"142":{"id":"/docs/architecture-61","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"Used for"},"143":{"id":"/docs/architecture-62","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"**Hermes `default` profile**"},"144":{"id":"/docs/architecture-63","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"claude-fable-5 @ high → claude-haiku-4.5 → gpt-5.6-terra"},"145":{"id":"/docs/architecture-64","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"Briefs, journal, cron ops, `@persik_hermes_bot`"},"146":{"id":"/docs/architecture-65","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"**`persiknewfin` profile**"},"147":{"id":"/docs/architecture-66","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"gpt-5.6-terra @ xhigh → gpt-oss-120b:free (OpenRouter) → gemini-2.5-flash"},"148":{"id":"/docs/architecture-67","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"Manual/gateway agentic runs (web + terminal toolsets)"},"149":{"id":"/docs/architecture-68","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"**Auxiliary roles** (vision, compression, subagents…)"},"150":{"id":"/docs/architecture-69","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"gpt-5.4-mini → claude-haiku-4.5"},"151":{"id":"/docs/architecture-70","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"Utility calls"},"152":{"id":"/docs/architecture-71","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"**Newfin `/ask` + `/research`**"},"153":{"id":"/docs/architecture-72","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"subscription OAuth CLIs directly (Claude Code / Codex) — no Hermes profile"},"154":{"id":"/docs/architecture-73","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"Advisor + research turns"},"155":{"id":"/docs/architecture-74","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"**Newfin STT / media**"},"156":{"id":"/docs/architecture-75","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"direct Gemini, key×model failover (`gemini-media-chain`, fallback gemini-3.5-flash)"},"157":{"id":"/docs/architecture-76","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#1b-llm-gateway--subscription-oauth-no-api-billing-as-of-2026-07-10","content":"Voice, photo"},"158":{"id":"/docs/architecture-77","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"Open-source personal-finance platform: net worth across crypto, real estate, equities, cash. API-first (`/v1`), an LLM advisor, and the household Telegram bot `@Persik_finbot`. **Read-only at the UX layer** — monitors Binance futures, never executes trades."},"159":{"id":"/docs/architecture-78","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"**Stack:** Node 20 + Express (TS, ESM) · React 19 + Vite + Tailwind · Supabase Postgres + RLS · Vercel/VPS · Recharts/React Query/Zustand · Zod."},"160":{"id":"/docs/architecture-79","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"**Workspaces:**"},"161":{"id":"/docs/architecture-80","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"`/shared` (`@newfin/shared`) — NW math, FX, scenario engine, Zod schemas."},"162":{"id":"/docs/architecture-81","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"`/server` — `/v1` REST, integrations, `lib/advisor`, alert-engine, futures-service."},"163":{"id":"/docs/architecture-82","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"`/server/persik` — bot: dispatch · lanes (Advisor/Journal) · menus · ops-proxy · **hermes-bridge** · queue-worker."},"164":{"id":"/docs/architecture-83","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"`/web` — Portfolio, Trading Desk, Cashflow, Advisor, Goals, Integrations."},"165":{"id":"/docs/architecture-84","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"**Integrations:** Binance Futures · Zerion · CoinGecko · Monobank · EtherFi · exchangerate.host · Telegram · &#x2A;*Hermes VPS (ssh)** · Claude → Gemini."},"166":{"id":"/docs/architecture-85","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"**Key patterns:** lane-based bot routing; **Hermes bridge** SSH-forwards owner advisor turns to the VPS; 24h-cached LLM context (hash of state+intel+memory); role-scoped views (`scopeForViewer`); fill-driven futures position reconstruction + income-ledger enrichment; structured (Zod) LLM output."},"167":{"id":"/docs/architecture-86","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#2-newfin--net-worth--financial-advisor-devnewfin","content":"**Advisor flow:** TG webhook → role+lane → assemble `FinancialState` → LLM (24h cache) → reply + thread."},"168":{"id":"/docs/architecture-87","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"Telegram-first family recipe app: captures recipes (YouTube / photo / text) with their stories and bilingual (EN + UK) context, extracts ingredients + nutrition via AI, then does weekly meal planning + grocery lists. **Multi-tenant by design** (\"family now, product later\"); \\~$0/mo on free tiers."},"169":{"id":"/docs/architecture-88","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"**Stack:** Supabase Edge Functions (Deno) · grammY bot framework · Supabase Postgres + RLS + Storage · React 18 + Vite (Telegram Mini App) · Vercel · Zod · `@rodyna/ui`."},"170":{"id":"/docs/architecture-89","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"**Modules:**"},"171":{"id":"/docs/architecture-90","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"`telegram-webhook` — entry point, acks \\<1s, enqueues a `jobs` row."},"172":{"id":"/docs/architecture-91","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"`process-recipe` — async worker: Gemini extract → ingredient catalog → USDA nutrition → persist."},"173":{"id":"/docs/architecture-92","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"`api` — REST for the Mini App (auth via Telegram `initData`, CRUD, search)."},"174":{"id":"/docs/architecture-93","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"`_shared/worker` + `packages/shared` — gemini, usda, catalog, prompts, i18n."},"175":{"id":"/docs/architecture-94","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"**Integrations:** Telegram · Google Gemini (flash/flash-lite) · USDA FoodData Central · Supabase Cloud · Vercel."},"176":{"id":"/docs/architecture-95","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"**Key patterns:** async job queue (fast-ack via `waitUntil`, idempotent, `pg_cron` sweep retry); **immutable originals** (DB trigger blocks edits) + full version snapshots; Zod at every boundary; ingredient-catalog specificity matching."},"177":{"id":"/docs/architecture-96","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#3-rodyna--family-recipes-devrodyna","content":"**Ingest flow:** YouTube link → ack + `jobs` row → Gemini extract → USDA + Nutri-Score → edit message into a recipe card."},"178":{"id":"/docs/architecture-97","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#4-draw--tennis-community-platform-devdraw","content":"Shared dev environment for the Draw platform: tournaments (registration, NTRP gating, single elim / round robin / Swiss draws, scoring, standings), seasonal leagues, challenge matches, casual games, rankings, notifications. Delivered as Telegram Mini App + web app + native mobile sharing one Next.js backend."},"179":{"id":"/docs/architecture-98","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#4-draw--tennis-community-platform-devdraw","content":"**Stack:** Next.js App Router (apps/web/) · React Native CLI (apps/mobile/) · Supabase Postgres · packages/shared (domain logic, draw algorithms, i18n) · FastAPI sidecar (services/auto\\_post/) for cross-platform reel publishing · next-intl (en/ru/uk/pl/be) · Web Push (VAPID) + APNS · Sentry."},"180":{"id":"/docs/architecture-99","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#4-draw--tennis-community-platform-devdraw","c